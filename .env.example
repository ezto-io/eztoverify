# Root compose env. Copy to .env (git-ignored) and edit.
# Only needed for the optional nginx HTTPS overlay (docker-compose.proxy.yml);
# the base `docker compose up` ignores this file.

# Public domain the IdP is served on (TLS). Must resolve to this host (DNS A record,
# or add to /etc/hosts -> 127.0.0.1 for local testing).
DOMAIN=verify.example.com
