# Root compose env. Copy to .env (git-ignored) and edit.
# REQUIRED by docker-compose.yml — the stack serves HTTPS via the bundled nginx
# TLS proxy and refuses to start without DOMAIN. The plain-HTTP dev infra file
# (docker-compose.dev.yml) ignores this file.

# Public domain the IdP is served on (TLS). Must resolve to this host (DNS A record,
# or add to /etc/hosts -> 127.0.0.1 for local testing). TLS certs for it go in
# nginx/certs/ (fullchain.pem + privkey.pem); for local testing generate one with
# DOMAIN=<your-domain> ./nginx/gen-self-signed.sh
DOMAIN=verify.example.com
