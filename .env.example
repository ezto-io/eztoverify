# ezto Verify — Docker Compose deployment environment.
#
#   cp .env.example .env    # then edit, or let scripts/deploy-compose.sh generate it
#
# .env is git-ignored and must be mode 600: it holds every credential the stack
# uses. docker-compose.yml reads each required value as ${VAR:?}, so an unset
# value stops the stack with a named error instead of silently using a default.
#
# docker-compose.dev.yml (plain-HTTP contributor infra) ignores this file.

# --- Identity of the deployment ---------------------------------------------
# Public domain the IdP is served on. Must resolve to this host. TLS certs for
# it live in nginx/certs/ (fullchain.pem + privkey.pem).
DOMAIN=verify.example.com
# --- Images -----------------------------------------------------------------
# Compose reads one fully resolved reference per service, so ANY registry
# naming works. scripts/deploy-compose.sh derives these from the flags below
# and records what it used; set them by hand if you prefer.
#
#   --registry eztovrfy --tag 1.0.0            -> eztovrfy/idp:1.0.0
#   --registry myorg --image-prefix ezto-      -> myorg/ezto-idp:1.0.0  (chart naming)
#   --image-repo myorg/ezto-oss                -> myorg/ezto-oss:idp    (service as tag)
#   --idp-image other/idp:9                    -> exactly that
IDP_IMAGE=eztovrfy/idp:1.0.0
BACKGROUND_IMAGE=eztovrfy/background:1.0.0
SOCKET_IMAGE=eztovrfy/socket:1.0.0
URL_SHORTENER_IMAGE=eztovrfy/url-shortener:1.0.0
# Only needed when the face-biometrics profile is active; leave it empty
# otherwise. Unlike the others this is optional, because Compose interpolates
# before it filters by profile.
LIVENESS_IMAGE=

# Recorded by the deployer for provenance; Compose never reads them.
REGISTRY=eztovrfy
IMAGE_PREFIX=
TAG=1.0.0

# --- Object storage image ----------------------------------------------------
# MinIO's own registries (quay.io/minio, docker.io/minio) now refuse anonymous
# pulls, so the default is a public build that carries both the server and mc.
# It tracks upstream and cannot be pinned, which is fine for an empty volume but
# not for a reproducible deployment — mirror the release you want and set:
#   MINIO_IMAGE=your-registry/minio:RELEASE.2025-09-07T16-13-09Z
# MINIO_MC_IMAGE only matters if your mirror splits the server and client; by
# default the init job reuses MINIO_IMAGE, which already provides mc.
MINIO_IMAGE=chainguard/minio:latest
#MINIO_MC_IMAGE=

# --- TLS --------------------------------------------------------------------
# self-signed = scripts/deploy-compose.sh generates a certificate (browsers warn).
# files       = you placed fullchain.pem and privkey.pem in nginx/certs yourself.
TLS_MODE=self-signed

# CERTS_DIR is the directory on THIS HOST holding the certificates; it is mounted
# read-only into nginx at /etc/nginx/certs. SSL_CERT_FILE and SSL_KEY_FILE are
# the paths as seen INSIDE the container.
#
# Self-signed or hand-placed certificates — the default:
#   CERTS_DIR=./nginx/certs
#   SSL_CERT_FILE=/etc/nginx/certs/fullchain.pem
#   SSL_KEY_FILE=/etc/nginx/certs/privkey.pem
#
# Managed certificates (Let's Encrypt / certbot) — read in place, so a renewal
# needs no copying, only an nginx reload:
#   CERTS_DIR=/etc/letsencrypt
#   SSL_CERT_FILE=/etc/nginx/certs/live/your-domain/fullchain.pem
#   SSL_KEY_FILE=/etc/nginx/certs/live/your-domain/privkey.pem
# Mount the whole /etc/letsencrypt, not just live/ — the files there are
# symlinks into ../../archive and break if that directory is not mounted too.
#
# After any renewal:  docker compose exec nginx nginx -s reload
CERTS_DIR=./nginx/certs
SSL_CERT_FILE=/etc/nginx/certs/fullchain.pem
SSL_KEY_FILE=/etc/nginx/certs/privkey.pem

# --- Admin realm -------------------------------------------------------------
# Realm holding the root account. Keycloak's default is "master", and a fresh
# install creates it. Set this when you restore a database whose admin realm is
# something else, or the admin console 404s and the bootstrap cannot run.
ROOT_ACCOUNT_NAME=master

# --- Credentials (generated by scripts/deploy-compose.sh) -------------------
# Rotating these after first start does NOT re-key existing data. See
# docs/deployment-compose.md "Adopting an existing stack".
POSTGRES_USER=ezto
POSTGRES_PASSWORD=
MINIO_ROOT_USER=ezto
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Shared by the IdP (SHORTENER_KEY) and the URL shortener (VALID_API_KEYS).
# One variable so the two can never drift apart.
SHORTENER_KEY=

# --- Endpoints --------------------------------------------------------------
# Internal service names when the matching infra-* profile is on; your own
# endpoint when it is off. Dropping a profile has preconditions — see
# docs/deployment-compose.md "External stores".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MINIO_SERVER_URL=http://minio:9000
# Browser-facing URL for public objects. NOT derivable from MINIO_SERVER_URL.
# Must be reachable by an end user's browser; required when MinIO is external.
MINIO_PUBLIC_URL=https://verify.example.com/storage/ezto-verify/public
MINIO_BUCKET=ezto-verify
# Bare hostname and port, not a URL.
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http

# --- IdP behaviour ----------------------------------------------------------
# Exact comma-separated IPs allowed to perform master-tenant onboarding.
# NO CIDR. Behind nginx this is compared against the X-Real-IP header, so it
# must contain the real client IP of the browser doing the onboarding — not
# this host's own address.
ROOT_ACCESS_IP=127.0.0.1,::1
# Admin-console and email "Docs" links. Empty hides them.
DOCS_URL=
DOCS_LINK=

# --- Service URLs advertised by the IdP -------------------------------------
# Each must be EMPTY when the matching profile is off, so the IdP does not
# advertise a service that is not running. scripts/deploy-compose.sh keeps
# these in step with COMPOSE_PROFILES; edit both together if you hand-edit.
BACKGROUND_JOB_URL=http://background:8070
SOCKET_URL=http://socket:3001
SHORTENER_HTTP_URL=http://url-shortener:3000
SHORTENER_HTTPS_URL=http://url-shortener:3000
# Face liveness is off by default (~15 GB image). Leave this empty unless the
# face-biometrics profile is active.
LIVELINESS_URL=

# --- Active services and bundled stores -------------------------------------
# Drop an infra-* profile to use your own store. Drop a service profile to not
# run it — and blank its URL above. Add face-biometrics to enable liveness.
COMPOSE_PROFILES=infra-postgres,infra-minio,infra-elasticsearch,background,socket,url-shortener
