#!/bin/sh
# =============================================================================
# EZTO Verify - IdP (Keycloak) local-dev environment
# =============================================================================
# Wired to docker-compose.infra.yml (postgres / minio / elasticsearch / maildev).
#
# Usage:
#   1. Start infra:  docker compose -f docker-compose.infra.yml up -d
#   2. cp .env.example .env  (then fill REPLACE_ME values you actually need)
#   3. source ./.env  (or: set -a; . ./.env; set +a)  before running the IdP.
#
# Shell `export VAR=value` style matches the existing env-eztovrfy.sh.
# REPLACE_ME = a real secret/value you must supply. NEVER commit real secrets.
# Vars marked [OPTIONAL] are feature-gated and can be left unset for basic dev.
# =============================================================================

# ----------------------------------------------------------------------------
# REQUIRED BASELINE
# ----------------------------------------------------------------------------
export KC_DB=postgres
export KC_DB_USERNAME=admin
export KC_DB_PASSWORD=admin
export KC_DB_URL_PORT=5432
export KC_DB_URL_HOST=127.0.0.1
export KC_DB_URL_DATABASE=eztoverify
export IDP_HOST=http://localhost:8080
# KC 18 reads KC_HOSTNAME_URL -> hostname-url. Forces all frontend URLs (short-link target,
# redirect_uri, OIDC issuer) onto IDP_HOST instead of the inbound request Host. For real-device
# testing set IDP_HOST to a device-reachable host (LAN IP), NOT localhost.
export KC_HOSTNAME_URL="${IDP_HOST}/auth"
export BACKGROUND_JOB_URL=http://localhost:8070
export JOB_DB_TYPE=psql
export CUSTOMER=ezto
export VARIANT="ezto verify"
# Admin-console "Docs" link target. Set to your self-hosted docs URL (e.g. https://docs.your-domain.com).
# Leave empty to show the bundled "documentation not configured" page. [OPTIONAL]
export DOCS_URL=""
# "Docs" link in emails / welcome page / account console. Self-hosted docs URL; empty hides those links. [OPTIONAL]
export DOCS_LINK=""
export SHORTENER_HTTPS_URL=http://localhost:3000
export MINIO_SERVER_URL=http://127.0.0.1:9000
export MINIO_SERVER_API_URL=http://localhost:9000
export MINIO_ACCESS_KEY=minioadmin
export MINIO_SECRET_KEY=minioadmin123
export MINIO_PUBLIC_URL=http://localhost:9000/ezto-verify/public

# ----------------------------------------------------------------------------
# DEPLOYMENT / IDENTITY
# ----------------------------------------------------------------------------
# Logical environment name (dev/qa/prod). Drives behaviour switches.
export ENV=dev
# On-prem / local: explicit dashboard URL. Overrides the multi-tenant
# dashboard.<ENV>.<ROOT_DNS_NAME> host (which won't resolve off-cloud).
# This is where onboarding/workspace-setup redirects after completion.
export DASHBOARD_URL=http://localhost:8080
# Root account + DNS used for reserved-name / tenant-subdomain resolution.
export ROOT_ACCOUNT_NAME=grootan
export ROOT_DNS_NAME=localhost
# Comma-separated IPs allowed to create the master-realm admin / complete
# master-tenant onboarding (the welcome-page "create admin" POST). The gate
# ONLY applies to the master realm; all other realms are always allowed.
# MUST be set (empty/unset -> NPE -> HTTP 500 on the welcome page).
# Matching is exact per IP (no CIDR ranges). Behind the nginx proxy overlay
# the idp reads the X-Real-IP header, so the value compared is your real
# browser/public IP -- add that here for a proxied deploy. Direct docker-compose
# (no proxy) sees the docker gateway IP instead; compose already whitelists
# the common gateways (see docker-compose.yml). Once onboarding is complete
# the check is never reached again.
export ROOT_ACCESS_IP=127.0.0.1
# Tenant subdomains the platform reserves and will not hand out.
export RESERVED_TENANT_NAMES=sso,www,license,payment,sales,minio,minio-api,strapi,debugger,cdn,static,dashboard,master,support,docs,dev,dev-docs,url-shortener

# ----------------------------------------------------------------------------
# DATABASE (postgres - compose: 127.0.0.1:5432, admin/admin, db=eztoverify)
# ----------------------------------------------------------------------------
# KC_DB_* above is the primary Keycloak datasource. The Background-job runner
# (JobRunr) reuses the same postgres; JOB_DB_TYPE=psql selects the SQL store.

# ----------------------------------------------------------------------------
# MINIO / OBJECT STORAGE (compose: 127.0.0.1:9000, minioadmin/minioadmin123)
# ----------------------------------------------------------------------------
# Bucket `ezto-verify` is created by the minio-init one-shot in the compose file.
# MINIO_SERVER_URL / _API_URL / _ACCESS_KEY / _SECRET_KEY / _PUBLIC_URL set above.

# ----------------------------------------------------------------------------
# ELASTICSEARCH (compose: http://127.0.0.1:9200 - event/audit/transaction store)
# ----------------------------------------------------------------------------
export ES_HOST=127.0.0.1
export ES_PORT=9200
export ES_SCHEME=http

# ----------------------------------------------------------------------------
# SMTP / EMAIL (compose: maildev @ 127.0.0.1:1025, no auth, no TLS; UI :1080)
# ----------------------------------------------------------------------------
# NOTE: Keycloak SMTP is configured per-realm (realm "Email" settings / import),
# not via process env vars. Point the realm SMTP config at:
#   host=127.0.0.1  port=1025  auth=off  ssl=off  starttls=off
# These are provided for convenience / scripted realm provisioning:
export SMTP_HOST=127.0.0.1
export SMTP_PORT=1025

# ----------------------------------------------------------------------------
# SIBLING SERVICES (run separately on localhost)
# ----------------------------------------------------------------------------
# Background job runner (set in baseline): http://localhost:8070
# URL shortener API (SHORTENER_HTTPS_URL set in baseline): http://localhost:3000
export SHORTENER_HTTP_URL=http://localhost:3000
# API key for the url-shortener service.
export SHORTENER_KEY=REPLACE_ME
# Socket service (listens on 3001).
export SOCKET_URL=http://localhost:3001
# Liveness / face-liveliness service (listens on 5000).
export LIVELINESS_URL=http://localhost:5000
# Video-KYC post-processing server.
export EZTO_VERIFY_VIDEO_POST_PROCESSING_SERVER_URL=http://localhost:8000
# Web-push notification server.
export WEB_PUSH_SERVER=http://localhost:4000
# Product version (drives qv-version -> Version.QV_VERSION -> migration target).
# Must be >= highest QV migrator (9.0.5) so workspace migrators run.
export APP_PUSH_VERSION=9.3.1

# ----------------------------------------------------------------------------
# OAUTH / IDP FEDERATION  [OPTIONAL] - only if you enable social/AAD/Google login
# ----------------------------------------------------------------------------
# Azure AD (Microsoft Entra) federation.
export AAD_CLIENT_ID=REPLACE_ME
export AAD_CLIENT_SECRET=REPLACE_ME
# Google Workspace federation.
export GWS_CLIENT_ID=REPLACE_ME
export GWS_CLIENT_SECRET=REPLACE_ME

# ----------------------------------------------------------------------------
# VAULT  [OPTIONAL] - external secrets backend; skip for local dev
# ----------------------------------------------------------------------------
export VAULT_URL=REPLACE_ME
export VAULT_USER=REPLACE_ME
export VAULT_PASS=REPLACE_ME
export VAULT_ENGINE_NAME=REPLACE_ME
export VAULT_NAMESPACE=REPLACE_ME
export VAULT_LOGIN_MOUNT_PATH=REPLACE_ME

# ----------------------------------------------------------------------------
# API CONNECTOR  [OPTIONAL / DEFERRED] - feature not active in OSS release
# ----------------------------------------------------------------------------
export API_CONNECTOR_HOST_URL=REPLACE_ME

# ----------------------------------------------------------------------------
# DNS / INGRESS / LOAD BALANCER  [OPTIONAL] - cloud/cluster custom-domain setup
# ----------------------------------------------------------------------------
export DNS_RESOLVER_ADDR=REPLACE_ME
export INGRESS_ENDPOINT=REPLACE_ME
export LB_ENDPOINT=REPLACE_ME
export LB_RECORD_TYPE=REPLACE_ME

# ----------------------------------------------------------------------------
# THIRD-PARTY KEYS / TOKENS  [OPTIONAL] - features degrade gracefully if unset
# ----------------------------------------------------------------------------
# GitHub token used to pull private artifacts/assets at build/runtime.
export DOWNLOAD_TOKEN=REPLACE_ME
# Authenticator app download links shown on the CIBA QR / deep-link page.
# Preferred: set per-realm via CIBA config (app-store-link / play-store-link).
# These server-wide env vars are the fallback; leave unset to omit the links.
export VERIFY_APP_IOS_URL=REPLACE_ME
export VERIFY_APP_ANDROID_URL=REPLACE_ME
# Segment analytics write key (server-side).
export EZTO_JAVA_SEGMENT_WRITE_KEY=REPLACE_ME

# ----------------------------------------------------------------------------
# MISC  [OPTIONAL]
# ----------------------------------------------------------------------------
# Debugger / inspector service endpoint.
export DEBUGGER_URL=http://localhost:8090/debug
