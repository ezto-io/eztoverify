      <div style="padding: 60px 70px; border-top: 1px solid rgba(0,0,0,0.05);">
        <h1 style="margin-top: 0px;">
          <@page_title/>
        </h1>
        <div style="color: #636363; font-size: 14px;">
           <@page_body/>
        </div>
    </div>
  </body>
</html>