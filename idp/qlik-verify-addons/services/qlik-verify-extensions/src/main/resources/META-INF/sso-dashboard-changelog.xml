<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="sso-dashboard-1.0">
        <createTable tableName="SSO_DASHBOARD">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REPRESENTATION_JSON" type="VARCHAR(25500)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="SSO_DASHBOARD" indexName="idx_realm_id_user_id">
            <column name="REALM_ID" type="VARCHAR(255)"/>
            <column name="USER_ID" type="VARCHAR(255)"/>
        </createIndex>
        <addPrimaryKey tableName="SSO_DASHBOARD" columnNames="ID"/>
    </changeSet>
</databaseChangeLog>