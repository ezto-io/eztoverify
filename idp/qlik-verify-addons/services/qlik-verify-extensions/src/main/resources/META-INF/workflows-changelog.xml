<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="workflows-1.0">
        <createTable tableName="WORKFLOWS">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="FLOW_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="FLOW_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CONNECTED_APP" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="WEBHOOK_URL" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_TIME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="ICON_URL" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="WORKFLOWS" indexName="idw_realm_id">
            <column name="REALM_ID" type="VARCHAR(255)"/>
        </createIndex>
        <addPrimaryKey tableName="WORKFLOWS" columnNames="ID"/>
    </changeSet>
</databaseChangeLog>