<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="qlik-verify-1.15">
        <createTable tableName="BRANDING">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)"/>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="IS_REALM_BRAND" type="BOOLEAN"/>
            <column name="CREATED_TIMESTAMP" type="BIGINT"/>
        </createTable>

        <createTable tableName="BRANDING_ATTRIBUTES">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="BRAND_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="VALUE" type="VARCHAR(5000)"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="ID" constraintName="CONSTRAINT_BRANDING_ATTRIBUTE_PK" tableName="BRANDING_ATTRIBUTES"/>
        <addPrimaryKey columnNames="ID" constraintName="CONSTRAINT_BRAND_1" tableName="BRANDING"/>
        <addForeignKeyConstraint baseColumnNames="REALM_ID" baseTableName="BRANDING" constraintName="FK_3LQTJG40TVY1O9C9V3B3859OW" referencedColumnNames="ID" referencedTableName="REALM"/>
        <addForeignKeyConstraint baseColumnNames="BRAND_ID" baseTableName="BRANDING_ATTRIBUTES" constraintName="FK_OYZ7SKC00I3XBXFLZFVAVFYZ4" referencedColumnNames="ID" referencedTableName="BRANDING"/>
    </changeSet>
</databaseChangeLog>
