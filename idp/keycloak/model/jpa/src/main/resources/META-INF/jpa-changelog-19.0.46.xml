<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="ezto-verify-19.0.46">
        <addColumn tableName="ACTION">
            <column name="SUB_WORKFLOW"  type="BOOLEAN" defaultValue="false">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createTable tableName="EZTOVRFY_MARKETPLACE_TEMPLATE">
            <column name="ID" type="VARCHAR(36)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)"/>
            <column name="WORKFLOW_NAME" type="VARCHAR(255)"/>
            <column name="WORKFLOW_CATEGORY" type="VARCHAR(255)"/>
            <column name="IMAGE_URL" type="VARCHAR(2550)"/>
            <column name="WORKFLOW_DESCRIPTION" type="TEXT"/>
            <column name="TEMPLATE_TAG" type="VARCHAR(2550)"/>
            <column name="COUNTRY" type="VARCHAR(255)"/>
            <column name="MODIFIED_TIMESTAMP" type="BIGINT" />
            <column name="IS_PUBLISHED" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="WORKFLOW_ID" type="VARCHAR(36)"/>
            <column name="WORKFLOW_JSON" type="TEXT"/>
        </createTable>
        <createTable tableName="EZTOVRFY_MARKETPLACE_CATEGORY">
            <column name="ID" type="VARCHAR(36)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)"/>
            <column name="CATEGORY" type="VARCHAR(255)"/>
        </createTable>
        <addColumn tableName="ACTION">
            <column name="IS_MARKETPLACE" type="BOOLEAN" defaultValue="false">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
