<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="GROOTAN System" id="ezto-verify-2.1">
        <createTable tableName="MGMT_ACCESS_PERMS">
            <column name="MGMT_ACCESS_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="PERMISSION" type="VARCHAR(36)"/>
            <column name="ENABLED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </createTable>
      </changeSet>

    <changeSet author="GROOTAN System" id="ezto-verify-2.2">
        <createTable tableName="MGMT_ACCESS">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)"/>
            <column name="NAME" type="VARCHAR(100)"/>
            <column name="EXPIRY_DATE" type="BIGINT"/>
            <column name="REQUESTED_BY" type="VARCHAR(36)"/>
            <column name="CREATED_DATE" type="BIGINT"/>
            <column name="LAST_UPDATED_DATE" type="BIGINT"/>
            <column name="LAST_USED_DATE" type="BIGINT"/>
            <column name="SECRET" type="VARCHAR(255)"/>
            <column name="ENABLED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="ID" constraintName="MGMT_ACCESS_PK" tableName="MGMT_ACCESS"/>
        <addUniqueConstraint tableName="MGMT_ACCESS" columnNames="REALM_ID,NAME" />
    </changeSet>
</databaseChangeLog>