<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="qlik-verify-2.5">
        <createTable tableName="WEB_DEVICE">
            <column name="DEVICE_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CLIENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="DEVICE_DATA" type="CLOB"/>
        </createTable>
        <addPrimaryKey columnNames="DEVICE_ID" constraintName="CONSTRAINT_WEB_DEVICE_PK" tableName="WEB_DEVICE"/>
        <createIndex indexName="IDX_DEVICE_ID" tableName="WEB_DEVICE">
            <column name="DEVICE_ID" type="VARCHAR(36)"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>