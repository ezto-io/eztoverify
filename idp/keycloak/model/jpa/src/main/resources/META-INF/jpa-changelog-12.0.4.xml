<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="GROOTAN System" id="qlik-verify-1.3">
        <createTable tableName="REALM_POLICY">
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="POL_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="POL_VALUE" type="VARCHAR(2550)">
                <constraints nullable="false"/>
            </column>
            <column name="IS_REALM_POL" type="BOOLEAN" defaultValue="false"/>
            <column name="POL_TYPE" type="VARCHAR(36)"/>
            <column name="CREATED_TIMESTAMP" type="BIGINT"/>
        </createTable>

        <addPrimaryKey columnNames="ID" constraintName="CONSTRAINT_KoKnTe8RS9" tableName="REALM_POLICY"/>
        <addForeignKeyConstraint baseColumnNames="REALM_ID" baseTableName="REALM_POLICY" constraintName="FK_70EJ8XDXGXD0B9HH6180IRR02" referencedColumnNames="ID" referencedTableName="REALM"/>
    </changeSet>
</databaseChangeLog>