# =============================================================================
# Verify - URL Shortener Service
# Environment configuration example. Copy to `.env` and adjust values.
#   cp .env.example .env
# Loaded via dotenv (require('dotenv').config()) at startup.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# HTTP listen port. App falls back to 3000 if unset (index.js). (optional)
PORT=3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
# Prisma reads DATABASE_URL directly (prisma/schema.prisma -> env("DATABASE_URL")).
# Use this for local / non-Docker runs. DB name for this service: urlshortner.
# (required)
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/urlshortner?schema=public

# -----------------------------------------------------------------------------
# Database parts (optional helpers)
# -----------------------------------------------------------------------------
# Optional helper vars for assembling DATABASE_URL manually:
#   postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public
# Not read by the app directly; for local runs set DATABASE_URL above instead.
# (optional)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=REPLACE_ME
DB_NAME=urlshortner

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Comma-separated list of valid API keys. Sent by clients via the `x-api-key`
# header to authorize POST / (short-link creation). SECRET - do not commit real
# values. Example: key-one,key-two (required)
VALID_API_KEYS=REPLACE_ME

# -----------------------------------------------------------------------------
# Application behavior
# -----------------------------------------------------------------------------
# Fallback URL to redirect to when a short link is missing or expired
# (helper.js -> getFallBackUrl). Point at the IdP / landing page as needed.
# (optional)
FALLBACK_URL=http://localhost:8080
