# =============================================================================
# Verify - Liveness Service (Python / Flask + Waitress)
# Copy to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
# The service listens on port 5000 (Dockerfile CMD: waitress-serve --port 5000).
# This value is NOT read from the environment by the code; it is fixed in the
# Dockerfile/CMD. Listed here for reference / when wiring docker-compose.
PORT=5000

# -----------------------------------------------------------------------------
# MinIO / Object Storage (REQUIRED)
# -----------------------------------------------------------------------------
# The service connects to MinIO with secure=False, so MINIO_HOST must be a
# bare host:port (NO http:// scheme). For the compose MinIO API on 127.0.0.1:9000:
MINIO_HOST=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET=minioadmin123

# Note: the bucket name is NOT an env var. It is passed per-request in the JSON
# body ("bucket_name"). The compose default bucket is `ezto-verify`.

# -----------------------------------------------------------------------------
# Liveness / Face matching tuning (OPTIONAL)
# -----------------------------------------------------------------------------
# Face match tolerance/threshold used by DeepFace comparisons.
# Code default: 0.68. Lower = stricter match.
FACE_TOLERANCE=0.68

# =============================================================================
# Notes:
# - No database is used (no Postgres/Redis/SQL references in the code).
# - No IdP (localhost:8080) reference in this service.
# - Model files (models/*.pth, *.caffemodel, *.prototxt) are bundled in the
#   image; no model-path env var is read.
# - hook_url / action_token are per-request JSON fields, not env vars.
# =============================================================================
