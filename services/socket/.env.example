# =============================================================================
# EZTO Verify - Socket (Node.js) Service
# =============================================================================
# Loaded via dotenv (require("dotenv").config()) at startup.
# Copy this file to `.env` and adjust values for your environment.
# Use plain KEY=value (no `export`).
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP / Socket.IO server
# -----------------------------------------------------------------------------
# Port the Express + Socket.IO server listens on.
# Code default: process.env.PORT || 3001
PORT=3001

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# The service uses node-postgres `new Pool()` with NO explicit config, so the
# driver reads the standard libpq environment variables below.
# Target table: `socket` (columns: trx_id, socket_id) in DB `socket`.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=admin
PGPASSWORD=admin
PGDATABASE=socket

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - No IdP/auth URL is referenced by this service. Socket connections are
#   authorized via a `chatcode` value passed in the handshake headers/auth,
#   not via the IdP at http://localhost:8080.
# - No JWT secrets, API keys, or tokens are read by the code. If you later add
#   any, define them here and set the value to REPLACE_ME (never commit real
#   secrets).
