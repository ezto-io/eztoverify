# ===========================================================================
# ezto-verify-platform — monorepo .gitignore
# ===========================================================================

# --- Internal dev / AI notes (not for public push; see dev-notes/CHANGES §42) ---
dev-notes/

# --- OS / editor / AI-agent tooling (never ship) --------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.claude/
.playwright-mcp/
dashboard-landing.png

# --- Secrets / local env (NEVER commit — rotate before publish) -----------
# Keep the *.example placeholders; ignore the real dev-cred files.
.env
.env.*
*.env
!.env.example
!.env.*.example
env-eztoauth.sh
env-eztovrfy.sh

# Signing keystores / push-provider service configs (authenticator)
*.jks
*.keystore
**/key.properties
**/gradle-local.properties
**/google-services.json
**/agconnect-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
# FCM service-account JSON used by scripts/seed-realm-attributes.sh (secret — never commit)
**/firebase-sa.json
**/firebase-service-account*.json
scripts/seed-data/firebase*.json

# --- Java / Maven (idp + qlik-verify-addons) ------------------------------
target/
*.class
# Build outputs — regenerated by build.sh (line 60 `rm -rf build_*`, then rebuilt) and
# excluded from the Docker context by .dockerignore (the image builds FROM SOURCE).
# Never commit: the in-repo copy goes stale (ships removed code) and bloats the repo ~464MB.
build_*/
qlik_verify_*/
# anchored to the build OUTPUT at idp/ root (build.sh:90) — must NOT match the
# tracked source template idp/build-tools/docker-keycloak/
/idp/docker-keycloak/
/idp/docker-keycloak.tar.gz
**/node_modules/
hs_err_pid*.log

# --- Node (docs site, services/socket, services/url-shortener) ------------
.docusaurus/
docs/verify/build/
npm-debug.log*
yarn-error.log*

# --- Flutter / Dart (authenticator) ---------------------------------------
.dart_tool/
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
*.lock.bak

# --- Python (services/liveness) -------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]

# --- local docker overrides (machine-specific port remaps etc) ------------
docker-compose.override.yml
docker-compose.*.local.yml

# --- Large redistributable binaries — fetch externally, never commit ------
# MS WebView2 installer (~170MB, exceeds GitHub limit). See webviewAsset/README.md
# + scripts/fetch-webview2.sh.
**/webviewAsset/WebView2Runtime.exe
# MaxMind GeoLite2 DB — EULA-restricted (no redistribution), bring-your-own.
# See idp/keycloak/public_files/maxmind/README.txt.
**/maxmind/*.mmdb

# --- misc runtime / logs --------------------------------------------------
*.log
*.pid
scheduled_tasks.lock
